generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/erp"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_ERP_URL")
  schemas  = ["asset", "finance", "hr", "inventory", "logistics", "org", "partner", "production", "purchase", "quality", "sales", "system", "trade"]
}

model asset {
  id                    Int       @id @default(autoincrement())
  assetCode             String?   @map("asset_code") @db.VarChar
  assetName             String?   @map("asset_name") @db.VarChar
  assetDescription      String?   @map("asset_description")
  categoryId            Int?      @map("category_id")
  serialNumber          String?   @map("serial_number") @db.VarChar
  barcode               String?   @db.VarChar
  manufacturer          String?   @db.VarChar
  model                 String?   @db.VarChar
  manufacturerYear      Int?      @map("manufacturer_year")
  purchaseDate          DateTime? @map("purchase_date") @db.Date
  purchasePrice         Decimal?  @map("purchase_price") @db.Decimal
  currentValue          Decimal?  @map("current_value") @db.Decimal
  depreciationMethod    String?   @map("depreciation_method") @db.VarChar
  location              String?   @db.VarChar
  status                String?   @db.VarChar
  assignedTo            Int?      @map("assigned_to")
  departmentId          Int?      @map("department_id")
  branchId              Int?      @map("branch_id")
  warrantyExpiryDate    DateTime? @map("warranty_expiry_date") @db.Date
  insurancePolicyNumber String?   @map("insurance_policy_number") @db.VarChar
  insuranceExpiryDate   DateTime? @map("insurance_expiry_date") @db.Date
  notes                 String?
  isActive              Boolean?  @map("is_active")
  createdAt             DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime? @map("updated_at") @db.Timestamp(6)

  @@schema("asset")
}

model asset_category {
  id                  Int       @id @default(autoincrement())
  categoryCode        String?   @map("category_code") @db.VarChar
  categoryName        String?   @map("category_name") @db.VarChar
  categoryDescription String?   @map("category_description")
  parentCategoryId    Int?      @map("parent_category_id")
  depreciationRate    Decimal?  @map("depreciation_rate") @db.Decimal
  usefulLifeYears     Int?      @map("useful_life_years")
  isActive            Boolean?  @map("is_active")
  createdAt           DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @map("updated_at") @db.Timestamp(6)

  @@schema("asset")
}

model maintenance_history {
  id              Int       @id @default(autoincrement())
  taskId          Int?      @map("task_id")
  assetId         Int?      @map("asset_id")
  maintenanceDate DateTime? @map("maintenance_date") @db.Date
  maintenanceType String?   @map("maintenance_type") @db.VarChar
  description     String?
  technician      String?   @db.VarChar
  downtimeHours   Decimal?  @map("downtime_hours") @db.Decimal
  cost            Decimal?  @db.Decimal
  status          String?   @db.VarChar
  resolution      String?
  partReplaced    String?   @map("part_replaced")
  notes           String?
  createdAt       DateTime? @map("created_at") @db.Timestamp(6)

  @@schema("asset")
}

model maintenance_schedule {
  id                  Int       @id @default(autoincrement())
  scheduleCode        String?   @map("schedule_code") @db.VarChar
  assetId             Int?      @map("asset_id")
  maintenanceType     String?   @map("maintenance_type") @db.VarChar
  frequencyDays       Int?      @map("frequency_days")
  nextMaintenanceDate DateTime? @map("next_maintenance_date") @db.Date
  estimatedCost       Decimal?  @map("estimated_cost") @db.Decimal
  priority            String?   @db.VarChar
  isRecurring         Boolean?  @map("is_recurring")
  assignedTeam        String?   @map("assigned_team") @db.VarChar
  notes               String?
  isActive            Boolean?  @map("is_active")
  createdAt           DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @map("updated_at") @db.Timestamp(6)

  @@schema("asset")
}

model maintenance_task {
  id              Int       @id @default(autoincrement())
  taskNumber      String?   @map("task_number") @db.VarChar
  assetId         Int?      @map("asset_id")
  scheduleId      Int?      @map("schedule_id")
  taskTitle       String?   @map("task_title") @db.VarChar
  taskDescription String?   @map("task_description")
  taskType        String?   @map("task_type") @db.VarChar
  priority        String?   @db.VarChar
  status          String?   @db.VarChar
  reportedBy      Int?      @map("reported_by")
  assignedTo      Int?      @map("assigned_to")
  approvedBy      Int?      @map("approved_by")
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  actualStartDate DateTime? @map("actual_start_date") @db.Date
  actualEndDate   DateTime? @map("actual_end_date") @db.Date
