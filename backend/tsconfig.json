{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir":          "./src",
    "outDir":           "./dist",
    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "paths": {
      "@zarat/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
