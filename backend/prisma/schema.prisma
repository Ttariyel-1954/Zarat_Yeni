generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_ERP_URL")
  schemas  = ["asset", "finance", "hr", "inventory", "logistics", "org", "partner", "production", "purchase", "quality", "sales", "system", "trade"]
}

model asset {
  id                      Int       @id @default(autoincrement())
  asset_code              String?   @db.VarChar
  asset_name              String?   @db.VarChar
  asset_description       String?
  category_id             Int?
  serial_number           String?   @db.VarChar
  barcode                 String?   @db.VarChar
  manufacturer            String?   @db.VarChar
  model                   String?   @db.VarChar
  manufacturer_year       Int?
  purchase_date           DateTime? @db.Date
  purchase_price          Decimal?  @db.Decimal
  current_value           Decimal?  @db.Decimal
  depreciation_method     String?   @db.VarChar
  location                String?   @db.VarChar
  status                  String?   @db.VarChar
  assigned_to             Int?
  department_id           Int?
  branch_id               Int?
  warranty_expiry_date    DateTime? @db.Date
  insurance_policy_number String?   @db.VarChar
  insurance_expiry_date   DateTime? @db.Date
  notes                   String?
  is_active               Boolean?
  created_at              DateTime? @db.Timestamp(6)
  updated_at              DateTime? @db.Timestamp(6)

  @@schema("asset")
}

model asset_category {
  id                   Int       @id @default(autoincrement())
  category_code        String?   @db.VarChar
  category_name        String?   @db.VarChar
  category_description String?
  parent_category_id   Int?
  depreciation_rate    Decimal?  @db.Decimal
  useful_life_years    Int?
  is_active            Boolean?
  created_at           DateTime? @db.Timestamp(6)
  updated_at           DateTime? @db.Timestamp(6)

  @@schema("asset")
}

model maintenance_history {
  id               Int       @id @default(autoincrement())
  task_id          Int?
  asset_id         Int?
  maintenance_date DateTime? @db.Date
  maintenance_type String?   @db.VarChar
  description      String?
  technician       String?   @db.VarChar
  downtime_hours   Decimal?  @db.Decimal
  cost             Decimal?  @db.Decimal
  status           String?   @db.VarChar
  resolution       String?
  part_replaced    String?
  notes            String?
  created_at       DateTime? @db.Timestamp(6)

  @@schema("asset")
}

model maintenance_schedule {
  id                    Int       @id @default(autoincrement())
  schedule_code         String?   @db.VarChar
  asset_id              Int?
  maintenance_type      String?   @db.VarChar
  frequency_days        Int?
  next_maintenance_date DateTime? @db.Date
  estimated_cost        Decimal?  @db.Decimal
  priority              String?   @db.VarChar
  is_recurring          Boolean?
  assigned_team         String?   @db.VarChar
  notes                 String?
  is_active             Boolean?
  created_at            DateTime? @db.Timestamp(6)
  updated_at            DateTime? @db.Timestamp(6)

  @@schema("asset")
}

model maintenance_task {
  id                Int       @id @default(autoincrement())
  task_number       String?   @db.VarChar
