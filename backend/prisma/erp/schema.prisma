  downtimeHours   Decimal?  @db.Decimal @map("downtime_hours")
  cost             Decimal?  @db.Decimal
  status           String?   @db.VarChar
  resolution       String?
  partReplaced    String? @map("part_replaced")
  notes            String?
  createdAt       DateTime? @db.Timestamp(6) @map("created_at")

  @@schema("asset")
}

model maintenance_schedule {
  id                    Int       @id @default(autoincrement())
  scheduleCode         String?   @db.VarChar @map("schedule_code")
