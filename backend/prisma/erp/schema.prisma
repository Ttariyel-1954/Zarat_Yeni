generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/erp"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_ERP_URL")
  schemas  = ["asset", "finance", "hr", "inventory", "logistics", "org", "partner", "production", "purchase", "quality", "sales", "system", "trade"]
}

model asset {
  id                      Int       @id @default(autoincrement())
  assetCode              String?   @db.VarChar @map("asset_code")
  assetName              String?   @db.VarChar @map("asset_name")
  assetDescription       String? @map("asset_description")
  categoryId             Int? @map("category_id")
  serialNumber           String?   @db.VarChar @map("serial_number")
  barcode                 String?   @db.VarChar
  manufacturer            String?   @db.VarChar
  model                   String?   @db.VarChar
  manufacturerYear       Int? @map("manufacturer_year")
  purchaseDate           DateTime? @db.Date @map("purchase_date")
  purchasePrice          Decimal?  @db.Decimal @map("purchase_price")
  currentValue           Decimal?  @db.Decimal @map("current_value")
  depreciationMethod     String?   @db.VarChar @map("depreciation_method")
  location                String?   @db.VarChar
  status                  String?   @db.VarChar
  assignedTo             Int? @map("assigned_to")
  departmentId           Int? @map("department_id")
  branchId               Int? @map("branch_id")
  warrantyExpiryDate    DateTime? @db.Date @map("warranty_expiry_date")
  insurancePolicyNumber String?   @db.VarChar @map("insurance_policy_number")
  insuranceExpiryDate   DateTime? @db.Date @map("insurance_expiry_date")
  notes                   String?
  isActive               Boolean? @map("is_active")
  createdAt              DateTime? @db.Timestamp(6) @map("created_at")
  updatedAt              DateTime? @db.Timestamp(6) @map("updated_at")

  @@schema("asset")
}

model asset_category {
  id                   Int       @id @default(autoincrement())
  categoryCode        String?   @db.VarChar @map("category_code")
  categoryName        String?   @db.VarChar @map("category_name")
  categoryDescription String? @map("category_description")
  parentCategoryId   Int? @map("parent_category_id")
  depreciationRate    Decimal?  @db.Decimal @map("depreciation_rate")
  usefulLifeYears    Int? @map("useful_life_years")
  isActive            Boolean? @map("is_active")
  createdAt           DateTime? @db.Timestamp(6) @map("created_at")
  updatedAt           DateTime? @db.Timestamp(6) @map("updated_at")

  @@schema("asset")
}

model maintenance_history {
  id               Int       @id @default(autoincrement())
  taskId          Int? @map("task_id")
  assetId         Int? @map("asset_id")
